// Package pubsub vendors the project-side wiring for ix's pubsub block. The
// in-process, Postgres LISTEN/NOTIFY and Redis broker logic lives in the
// imported runtime module; this file is the single place {{.Module}}
// constructs a broker and re-exports the Broker surface the Subscription
// resolvers depend on.
package pubsub

import (
	"context"

	runtimepubsub "github.com/appsome/ix/runtime/pubsub"
)

// Options picks {{.Module}}'s broker: Redis when RedisURL is set, Postgres
// LISTEN/NOTIFY when DSN is set, in-process otherwise. Only Redis and
// Postgres reach subscribers in sibling processes.
type Options struct {
	// RedisURL is redis://[:password@]host:port[/db] or rediss:// for TLS.
	RedisURL string
	// RedisPrefix namespaces the Redis channels per deployment.
	RedisPrefix string
	// DSN is the Postgres to LISTEN on when RedisURL is empty.
	DSN string
	// Channels are the topics a Postgres broker LISTENs on; Redis needs none.
	Channels []string
}

// New returns a broker for {{.Module}} per opts. A Redis or Postgres broker
// that cannot connect is an error, never a silent in-process fallback. The
// broker runs until ctx is cancelled; callers Close it on shutdown.
func New(ctx context.Context, opts Options) (Broker, error) {
	switch {
	case opts.RedisURL != "":
		return runtimepubsub.NewRedisBroker(ctx, runtimepubsub.RedisOptions{URL: opts.RedisURL, Prefix: opts.RedisPrefix})
	case opts.DSN != "":
		// 0/0 reconnect bounds use the runtime defaults (10s/1m).
		return runtimepubsub.NewPostgresBroker(ctx, opts.DSN, opts.Channels, 0, 0)
	default:
		return runtimepubsub.NewInProcessBroker(), nil
	}
}

// NewBroker is New with a Postgres DSN and channels only, the block's 0.1
// signature.
func NewBroker(ctx context.Context, dsn string, channels ...string) (Broker, error) {
	return New(ctx, Options{DSN: dsn, Channels: channels})
}

// Broker is the runtime pub/sub surface, re-exported so the rest of {{.Module}}
// references this package rather than the runtime module directly.
type Broker = runtimepubsub.Broker
